map "${APP_ENV}" $gam_forwarded_host {
    default $host;
    local   $http_host;
}

map $http_x_forwarded_proto $gam_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

map $http_upgrade $gam_connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    client_max_body_size 25m;

    location = /docs {
        return 301 /docs/;
    }

    location /docs/ {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $gam_forwarded_proto;
        proxy_pass http://swagger-ui:8080/docs/;
    }

    location ^~ /app/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $gam_reverb reverb:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $gam_connection_upgrade;
        proxy_read_timeout 120s;
        proxy_pass http://$gam_reverb;
    }

    location / {
        include fastcgi_params;

        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param DOCUMENT_ROOT /var/www/html/public;

        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_param HTTP_X_FORWARDED_FOR $proxy_add_x_forwarded_for;
        fastcgi_param HTTP_X_FORWARDED_HOST $gam_forwarded_host;
        fastcgi_param HTTP_X_FORWARDED_PROTO $gam_forwarded_proto;

        fastcgi_connect_timeout 10s;
        fastcgi_send_timeout 60s;
        fastcgi_read_timeout 60s;
        fastcgi_hide_header X-Powered-By;

        fastcgi_pass api:9000;
    }
}
