includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - app/Models/IdentityAndAccess/Role.php
        - app/Models/User.php
        - app/Services/IdentityAndAccess
        - app/Actions/IdentityAndAccess
        - app/Policies/IdentityAndAccess
        - app/Http/Requests/IdentityAndAccess
        - app/Http/Controllers/IdentityAndAccess
        - app/Http/Resources/IdentityAndAccess
        - app/Queries/IdentityAndAccess
        - app/Http/Middleware/ValidateCurrentAccess.php
        - app/Policies/Inventory/FeedStockOperationPolicy.php
        - database/seeders/IdentityPermissionSeeder.php
        - database/factories/IdentityAndAccess
        - database/factories/UserFactory.php
    tmpDir: storage/framework/cache/phpstan-roles
